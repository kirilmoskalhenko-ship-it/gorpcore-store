# Переменные окружения ALTITUDE ARCHIVE. Секретов сайт сейчас не использует.
# Скопируйте в .env.local для локальной разработки или задайте в Vercel → Project → Settings → Environment Variables.

# Публичный адрес сайта для metadataBase / Open Graph (без слэша в конце).
# На Vercel можно не задавать: тогда берётся production-домен проекта (VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Только для локальных Playwright-тестов (необязательно):
# PW_CHANNEL=msedge
# PW_PORT=3030
